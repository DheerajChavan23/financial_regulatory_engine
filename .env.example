# Enterprise Regulatory & Operational Ingestion Engine - Environment Variables Template
# Copy this file to '.env' and fill in your values. DO NOT commit '.env' to git!

# Google GenAI / Gemini API Key (Optional for multimodal parsing; fallback parser is enabled by default)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Governance & Cryptographic Salt for Irish PPSN Pseudonymization (Required in Production)
ENGINE_GOVERNANCE__SALT=your_custom_secure_audit_salt_phrase_here

# Data Quality Thresholds
ENGINE_GOVERNANCE__MIN_QUALITY_SCORE=0.85
ENGINE_GOVERNANCE__COMPLETENESS_THRESHOLD=0.90
ENGINE_GOVERNANCE__STRICT_QUARANTINE=True

# Application Environment
ENGINE_APP__ENVIRONMENT=development
ENGINE_APP__LOG_LEVEL=INFO
ENGINE_APP__SERVER_PORT=8501
